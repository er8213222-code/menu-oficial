  <p>Victoria</p>  
</div>

  </div>  
</section>  <section>    <div class="label">ENCUÉNTRANOS</div>    <h2>  
    CAE POR<br>  
    UNOS TACOS.  
  </h2>    <div class="locations">  <div class="location">  
  <h3>EL TACONAZO</h3>  
  <p>  
    Ven a disfrutar nuestros tacos  
    y especialidades.  
  </p>  
  <a  
    class="btn"  
    href="https://maps.app.goo.gl/rxNcuHQQVn3jn7Rb6?g_st=aw"  
    target="_blank">  
    VER UBICACIÓN  
  </a>  
</div>  

<div class="location">  
  <h3>EL TACONAZO · EL TOMBERO</h3>  
  <p>  
    También puedes encontrarnos  
    en El Tombero.  
  </p>  
  <a  
    class="btn"  
    href="https://maps.app.goo.gl/ictFb4bgkbTwJkZJ7?g_st=aw"  
    target="_blank">  
    VER UBICACIÓN  
  </a>  
</div>

  </div>  </section>  <footer>  
  <strong>EL TACONAZO</strong>  
  <p>EMILIANO STUDIOS</p>  
</footer>  <button id="soundBtn" type="button">  
  ♫ AUDIO  
</button>  
<script>  
const tacoAudio = new Audio("audio.mp4");  tacoAudio.loop = true;
tacoAudio.volume = 0.55;

const soundBtn = document.getElementById("soundBtn");
const menuBtn = document.getElementById("menuBtn");

menuBtn.addEventListener("click", () => {
tacoAudio.play().catch(() => {});
soundBtn.textContent = "♫ APAGAR AUDIO";
});

soundBtn.addEventListener("click", () => {

if (tacoAudio.paused) {

tacoAudio.play().catch(() => {});  
soundBtn.textContent = "♫ APAGAR AUDIO";

} else {

tacoAudio.pause();  
tacoAudio.currentTime = 0;  
soundBtn.textContent = "♫ AUDIO";

}

});
</script>

</body>  
</html>
